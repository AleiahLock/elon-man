# Copy to core/.env and fill in. Never commit .env.

# Serial port of the ESP32. "fake" runs without hardware.
# Find it with: ls /dev/cu.usbmodem*
ELONMAN_PORT=fake

# Plugins to load (each needs a manifest in core/manifests/)
ELONMAN_PLUGINS=vision,voice,mail_bridge

# ---- vision ----
CAMERA_INDEX=0
# 1 or -1: flip if he turns away from your face instead of toward it
PAN_SIGN=1
# Office hours for the motion_after_hours event, 24h, local time
WORK_HOURS=08-19

# ---- voice ----
# openWakeWord model: a built-in name (hey_jarvis) or a path to your own .onnx
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
WHISPER_MODEL=small.en
# Leave empty to use the macOS "say" voice. Or a path to a Piper .onnx voice
PIPER_MODEL=
# Live conversation runs on a Grok model through the xAI API
XAI_API_KEY=
# Pick a current chat model from console.x.ai
XAI_MODEL=

# ---- mail bridge (Way 3) ----
# A spare mailbox the robot sends from and reads replies in.
# Gmail: turn on 2-step verification and create an app password.
ROBOT_EMAIL=
ROBOT_EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
IMAP_HOST=imap.gmail.com
# The Grok Bot address with a plus alias, e.g. yourbot+elonman@...
BOT_EMAIL=
# Only replies from this address are read aloud
BOT_REPLY_FROM=

# ---- MCP server (Way 2) ----
# Long random string. Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(40))"
ELONMAN_MCP_KEY=
